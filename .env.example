# ===================================================================
# Cashfree Payment Gateway Credentials - DishaMail
# ===================================================================
# 1. Obtain your API Keys from Cashfree Dashboard:
#    https://merchant.cashfree.com/merchants/login
#    Navigate to: Payment Gateway -> Developers -> API Keys
# ===================================================================

# Cashfree Client / App ID
CASHFREE_APP_ID=your_cashfree_app_id_here

# Cashfree Client Secret Key
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# Environment: "production" for Live payments, or "sandbox" for Test
CASHFREE_ENV=production

# Server Port (for local Node.js server)
PORT=3000
